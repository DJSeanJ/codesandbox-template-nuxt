# Server-only secrets (never exposed to client)
ANTHROPIC_API_KEY=

# Comma-separated proper nouns the agent must never emit (real names, places).
# Used by post-flight moderation scan in server/utils/moderation.ts.
FORBIDDEN_PROPER_NOUNS=

# Public runtime values (safe to expose)
NUXT_PUBLIC_BRAND_NAME=Life Is Gonna Life
